{
  "version": 2,
  "builds": [
    {
      "src": "packages/client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.go",
      "use": "@vercel/go"
    },
    {
      "src": "packages/server/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/go/(.*)",
      "dest": "api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "packages/server/src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "packages/client/$1"
    }
  ]
}
