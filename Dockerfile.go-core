# Build stage
FROM golang:alpine AS builder
WORKDIR /app
COPY packages/go-core/go.mod ./packages/go-core/
COPY packages/go-core/engine ./packages/go-core/engine
COPY packages/go-core/main.go ./packages/go-core/
WORKDIR /app/packages/go-core
RUN go build -o go-core main.go

# Production stage
FROM alpine:latest
WORKDIR /app
COPY --from=builder /app/packages/go-core/go-core .
EXPOSE 8081
CMD ["./go-core"]
