{
  "name": "dusan-game-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Modulárny open-source herný engine poháňaný axiómami",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=apps/game-client",
    "dev:server": "npm run dev --workspace=apps/game-server",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "editor": "npm run dev --workspace=apps/editor-tool",
    "cli": "node tools/cli/dist/index.js",
    "docs": "npm run build --workspace=tools/docs",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.2.3",
    "@qoder-ai/qoder-agent-sdk": "^1.0.19",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dusan-game/engine.git"
  },
  "keywords": [
    "game-engine",
    "procedural-generation",
    "axiomatic-system",
    "open-source",
    "threejs",
    "react",
    "ml-integration"
  ],
  "author": "Dušan Game Community",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dusan-game/engine/issues"
  },
  "homepage": "https://dusan-game.dev"
}
