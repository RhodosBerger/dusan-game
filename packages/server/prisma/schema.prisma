// packages/server/prisma/schema.prisma

datasource db {
  provider = "sqlite"
  url      = "file:../database.db"
}

generator client {
  provider = "prisma-client-js"
}

// ── Player Account & Core Stats ──────────────────────────────────────────────
model Player {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  level        Int      @default(1)
  xp           Int      @default(0)
  mmr          Int      @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  inventory    Inventory[]
  cardDeck     PlayerCard[]
  quests       PlayerQuest[]
  items        PlayerItem[]
  artifacts    PlayerArtifact[]
  premiumPurchases PlayerPremiumPurchase[]
}

// ── Inventory Surovin (Materials obtained from chests) ────────────────────────
model Inventory {
  id          String   @id @default(uuid())
  playerId    String
  materialKey String   // e.g. "CrystalShard", "ToxicSpore", "Essence"
  amount      Int      @default(0)
  updatedAt   DateTime @updatedAt

  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, materialKey])
  @@index([playerId])
}

// ── Cards & Cosmetics Unlocked ───────────────────────────────────────────────
model PlayerCard {
  id               String   @id @default(uuid())
  playerId         String
  cardDefinitionId String // References CARD_DEFINITIONS base catalog
  customVoltage    Float?   // Crafting modified Voltage (V)
  customResistance Float? // Crafting modified Resistance (R)
  isShiny          Boolean  @default(false)
  unlockedAt       DateTime @default(now())

  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ── Daily Quests (Progress and roll status) ──────────────────────────────────
model PlayerQuest {
  id           String      @id @default(uuid())
  playerId     String
  questKey     String      // e.g. "WIN_MATCH_CRYSTAL", "COLLECT_CHESTS"
  progress     Int         @default(0)
  targetValue  Int
  completed    Boolean     @default(false)
  xpReward     Int
  rolledAt     DateTime    @default(now())

  player       Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, questKey])
  @@index([playerId])
}

// ── Player Purchased Items (Weapons, Tools, Harvest Equipment) ───────────────
model PlayerItem {
  id         String   @id @default(uuid())
  playerId   String
  itemKey    String   // e.g. "AETHER_SABER", "GRAVITY_HARVESTER"
  category   String   // "WEAPON", "TOOL", "HARVEST"
  quantity   Int      @default(1)
  durability Int      @default(100)
  unlockedAt DateTime @default(now())

  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ── Player Artifacts (Character Class Unique Items) ─────────────────────────
model PlayerArtifact {
  id               String   @id @default(uuid())
  playerId         String
  artifactKey      String   // e.g. "EXEMPLAR_CROWN", "SPELLWEAVER_AMULET"
  category         String   // "MAGIC"
  heroClass        String   // e.g. "SOVEREIGN_EXEMPLAR", "AETHER_SPELLWEAVER"
  spellReachBonus  Int      @default(0)
  damageBonus      Int      @default(0)
  unlockedAt       DateTime @default(now())

  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

// ── Card Trading (Transactions & Swaps) ──────────────────────────────────────
model CardTrade {
  id               String   @id @default(uuid())
  senderId         String
  receiverId       String?  // Optional: null for public offers
  offeredCardId    String   // References PlayerCard.id
  requestedCardDef String   // References cardDefinitionId they want in return (e.g. "crystal_laser_burst")
  status           String   // "PENDING" | "COMPLETED" | "CANCELLED"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([senderId])
  @@index([receiverId])
}

// ── Leaderboard Statistics (Score telemetry, steps, wins vs NPC/AI/Players) ──
model PlayerLeaderboard {
  id               String   @id @default(uuid())
  playerId         String   @unique
  stepsTaken       Int      @default(0)
  npcWins          Int      @default(0)
  npcMatches       Int      @default(0)
  aiWins           Int      @default(0)
  aiMatches        Int      @default(0)
  playerWins       Int      @default(0)
  playerMatches    Int      @default(0)
  overallScore     Float    @default(0)
  updatedAt        DateTime @updatedAt
}

// ── Katalóg prémiových položiek (Premium Items Catalog) ──────────────────────
model PremiumItem {
  id          String   @id @default(uuid())
  key         String   @unique // napr. "VOLTAGE_CORE", "GLACIER_SHIELD"
  name        String
  description String
  priceCredits Float
  createdAt   DateTime @default(now())

  purchases   PlayerPremiumPurchase[]
  modifiers   SkillDecimalModifier[]
}

// ── Transakcie prémiových nákupov (Premium Transactions) ────────────────────
model PlayerPremiumPurchase {
  id            String   @id @default(uuid())
  playerId      String
  premiumItemId String
  purchasedAt   DateTime @default(now())
  status        String   // "COMPLETED", "FAILED"

  player        Player      @relation(fields: [playerId], references: [username], onDelete: Cascade)
  item          PremiumItem @relation(fields: [premiumItemId], references: [id], onDelete: Cascade)
}

// ── Desatinné modifikátory skillov (Decimal Skill Modifiers) ────────────────
model SkillDecimalModifier {
  id            String   @id @default(uuid())
  premiumItemId String
  targetSkill   String   // napr. "crystal_laser_burst"
  attackBonus   Float    @default(0.0) // napr. +0.15 k sile útoku
  reachBonus    Float    @default(0.0) // napr. +0.1 k dosahu
  cooldownReduction Float @default(0.0)

  item          PremiumItem @relation(fields: [premiumItemId], references: [id], onDelete: Cascade)
}

