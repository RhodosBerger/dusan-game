{
  "name": "@dusan-game/server",
  "version": "1.0.0",
  "description": "Backend for Dušan Game",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/server.ts",
    "dev": "nodemon --exec ts-node src/server.ts",
    "db:seed": "ts-node src/prismaSeed.ts",
    "debug": "nodemon --exec \"node --inspect=0.0.0.0:9229 -r ts-node/register src/server.ts\""
  },
  "dependencies": {
    "@dusan-game/shared": "^1.0.0",
    "@prisma/client": "^6.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
